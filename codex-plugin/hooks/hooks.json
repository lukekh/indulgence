{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__.*indulgence.*__begin$",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/prayer-log.mjs\" begin", "timeout": 10 }]
      },
      {
        "matcher": "^mcp__.*indulgence.*__pray$",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/prayer-log.mjs\" pray", "timeout": 10 }]
      },
      {
        "matcher": "^mcp__.*indulgence.*__vigil$",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/prayer-log.mjs\" vigil", "timeout": 10 }]
      },
      {
        "matcher": "^mcp__.*indulgence.*__depart$",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/prayer-log.mjs\" depart", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/prayer-log.mjs\" stop codex", "timeout": 10 }]
      }
    ],
    "Interrupt": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/prayer-log.mjs\" interrupt", "timeout": 10 }]
      }
    ]
  }
}
