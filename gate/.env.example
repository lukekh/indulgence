# Public HTTPS URL of this gate, no trailing slash. It is also the JWT issuer that
# SpacetimeDB verifies via /.well-known/openid-configuration, so it must be reachable
# from Maincloud. Must match the module's INDULGENCE_ISSUER exactly.
GATE_PUBLIC_URL=https://gate.example.com
# Where the web client is hosted (viewer links point here; CORS allows this origin).
SITE_URL=https://indulgence.example.com

SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
SPACETIMEDB_MODULE=indulgence
# Defaults to SPACETIMEDB_MODULE; must match the module's INDULGENCE_AUDIENCE.
# SPACETIMEDB_AUDIENCE=indulgence

# GitHub OAuth App (no scopes). Callback: <GATE_PUBLIC_URL>/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secrets: inject from your secret manager.
# 32+ random characters. Never rotate it: account and follow-edge hashes depend on it.
EDGE_HMAC_KEY=
# ES256 private key (PKCS#8 PEM). Generate: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
GATE_SIGNING_KEY=
# or GATE_SIGNING_KEY_FILE=/run/secrets/gate-signing-key.pem
GATE_SIGNING_KID=gate-1
# During rotation: the other key's public JWK (or a JSON array of them).
# GATE_EXTRA_PUBLIC_JWKS=

# Redirect URIs clients may register: loopback http (Claude Code) always; other https
# origins only if listed here, comma-separated (e.g. a hosted MCP client's callback origin).
# GATE_ALLOWED_REDIRECT_ORIGINS=

PORT=8787
# Behind one reverse proxy (for per-IP rate limits):
TRUST_PROXY=1
NODE_ENV=production
