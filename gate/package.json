{
  "name": "indulgence-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.15",
    "spacetimedb": "^2.14.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "The /indulgence gate: remote MCP server, OAuth/OIDC issuer, spend and pacing.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --loader:.txt=text --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../module --yes",
    "build:data": "tsx scripts/build-data.ts",
    "test:stdb": "tsx test-integration/stdb.it.ts"
  }
}
